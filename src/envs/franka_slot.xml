
<mujoco model='franka_slot_insertion'>
  <compiler angle='radian' coordinate='local'/>
  <option timestep='0.001' gravity='0 0 -9.81' iterations='50' solver='Newton'/>
  <visual>
    <global offwidth='1920' offheight='1080'/>
    <quality shadowsize='2048'/>
    <headlight ambient='0.4 0.4 0.4' diffuse='0.6 0.6 0.6' specular='0.2 0.2 0.2'/>
  </visual>
  <default>
    <geom friction='0.4 0.005 0.0001' solref='0.004 1' solimp='0.9 0.95 0.001'/>
  </default>
  <worldbody>
    <light diffuse='.8 .8 .8' pos='0.1 -0.2 0.4' dir='-0.2 0.3 -0.8' castshadow='true'/>
    <light diffuse='.4 .4 .4' pos='-0.2 0.2 0.3' dir='0.3 -0.3 -0.6' castshadow='false'/>
    
    <!-- Table surface at z = 0 -->
    <geom name='table' type='plane' size='0.25 0.25 0.01' pos='0 0 0' rgba='0.92 0.93 0.95 1'/>
    
    <!-- Slot Receptacle (Cavity width: 10.30 mm, clearance: 0.15 mm) -->
    <!-- Left wall -->
    <geom name='wall_left' type='box' size='0.02 0.025 0.0125' 
          pos='-0.02515 0 0.0125' rgba='0.35 0.4 0.48 1'/>
    <!-- Right wall -->
    <geom name='wall_right' type='box' size='0.02 0.025 0.0125' 
          pos='0.02515 0 0.0125' rgba='0.35 0.4 0.48 1'/>
    <!-- Back wall -->
    <geom name='wall_back' type='box' size='0.00515 0.02 0.0125' 
          pos='0 -0.02515 0.0125' rgba='0.35 0.4 0.48 1'/>
    <!-- Front wall (Transparent acrylic to see inside cavity) -->
    <geom name='wall_front' type='box' size='0.00515 0.02 0.0125' 
          pos='0 0.02515 0.0125' rgba='0.35 0.55 0.75 0.30'/>

    <!-- 6-DoF End-Effector Base (Franka Panda wrist + gripper mass ~ 2.5 kg) -->
    <body name='ee_base' pos='0 0 0.080'>
      <joint name='slide_x' type='slide' axis='1 0 0' damping='15.0'/>
      <joint name='slide_y' type='slide' axis='0 1 0' damping='15.0'/>
      <joint name='slide_z' type='slide' axis='0 0 1' damping='15.0'/>
      <joint name='hinge_rx' type='hinge' axis='1 0 0' damping='1.5'/>
      <joint name='hinge_ry' type='hinge' axis='0 1 0' damping='1.5'/>
      <joint name='hinge_rz' type='hinge' axis='0 0 1' damping='1.5'/>
      <geom name='ee_gripper' type='box' size='0.016 0.016 0.006' pos='0 0 0.006' mass='2.5' rgba='0.2 0.22 0.26 1'/>
      
      <!-- Visual Gripper Fingers & GelSight Mini Tactile Pads -->
      <geom name='vis_finger_left' type='box' size='0.002 0.008 0.012' pos='-0.0075 0 -0.012' contype='0' conaffinity='0' rgba='0.25 0.28 0.32 1'/>
      <geom name='vis_gelsight_left' type='box' size='0.0008 0.0077 0.0093' pos='-0.0055 0 -0.012' contype='0' conaffinity='0' rgba='0.15 0.80 0.90 0.95'/>
      <geom name='vis_finger_right' type='box' size='0.002 0.008 0.012' pos='0.0075 0 -0.012' contype='0' conaffinity='0' rgba='0.25 0.28 0.32 1'/>
      <geom name='vis_gelsight_right' type='box' size='0.0008 0.0077 0.0093' pos='0.0055 0 -0.012' contype='0' conaffinity='0' rgba='0.15 0.80 0.90 0.95'/>

      <!-- Peg compliantly held between tactile elastomer pads -->
      <body name='peg' pos='0 0 -0.025'>
        <joint name='peg_dx' type='slide' axis='1 0 0' stiffness='15000' damping='40'/>
        <joint name='peg_dy' type='slide' axis='0 1 0' stiffness='15000' damping='40'/>
        <joint name='peg_dz' type='slide' axis='0 0 1' stiffness='30000' damping='80'/>
        <joint name='peg_drx' type='hinge' axis='1 0 0' stiffness='80' damping='1.5'/>
        <joint name='peg_dry' type='hinge' axis='0 1 0' stiffness='80' damping='1.5'/>
        <joint name='peg_drz' type='hinge' axis='0 0 1' stiffness='80' damping='1.5'/>
        <geom name='peg_geom' type='box' size='0.005 0.005 0.025' mass='0.08' rgba='0.92 0.38 0.22 1'/>
      </body>
    </body>
  </worldbody>
  <actuator>
    <motor name='act_fx' joint='slide_x' gear='1'/>
    <motor name='act_fy' joint='slide_y' gear='1'/>
    <motor name='act_fz' joint='slide_z' gear='1'/>
    <motor name='act_tx' joint='hinge_rx' gear='1'/>
    <motor name='act_ty' joint='hinge_ry' gear='1'/>
    <motor name='act_tz' joint='hinge_rz' gear='1'/>
  </actuator>
</mujoco>
